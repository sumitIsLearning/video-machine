+
+test('doctor.json records tool versions, paths and smoke timings', () => {
+  const d = DoctorSchema.parse({
+    checked_at: '2026-10-09T17:00:00Z',
+    tools: {
+      hyperframes: { ok: true, version: '0.8.143' },
