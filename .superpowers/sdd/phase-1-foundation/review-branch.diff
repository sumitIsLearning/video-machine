+  path: 'capture/shots/1.png',
+  source: 'replay',
+  license: 'own',
+  usage: 'render',
+};
+
+test('every asset records where it came from', () => {
+  for (const origin of ['supplied', 'nav_video', 'captured', 'web', 'found', 'drawn'] as const) {
+    expect(AssetRefSchema.parse({ ...asset, origin }).origin).toBe(origin);
