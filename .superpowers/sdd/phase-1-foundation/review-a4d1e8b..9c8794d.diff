+  expect(StepsSchema.safeParse([step(1), step(0)]).success).toBe(false);
+});
+
+test('an unknown step action is rejected', () => {
+  expect(StepsSchema.safeParse([step(0, { action: 'hover' })]).success).toBe(false);
